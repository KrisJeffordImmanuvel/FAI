{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Library Agent (opens in browser)",
      "type": "shell",
      "command": "python3 run.py",
      "windows": {
        "command": "python run.py"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Show AI outputs in the terminal (no website)",
      "type": "shell",
      "command": "python3 run.py --console",
      "windows": {
        "command": "python run.py --console"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Library Agent inside VS Code",
      "dependsOn": [
        "Start server (no browser)",
        "Open website inside VS Code"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Start server (no browser)",
      "type": "shell",
      "command": "python3 run.py --no-browser",
      "windows": {
        "command": "python run.py --no-browser"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "library-agent",
        "pattern": {
          "regexp": "^__never_matches__$"
        },
        "background": {
          "activesBegin": true,
          "beginsPattern": "Creating Python virtual environment|Installing|Checking the database|Resetting and seeding|Starting the server",
          "endsPattern": "Website is ready|already running at"
        }
      }
    },
    {
      "label": "Open website inside VS Code",
      "type": "shell",
      "command": "echo Opened http://localhost:8000 in the VS Code browser tab ${input:openSimpleBrowser}",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run all tests",
      "type": "shell",
      "command": "python3 run.py --test",
      "windows": {
        "command": "python run.py --test"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Reset demo data and run",
      "type": "shell",
      "command": "python3 run.py --reset",
      "windows": {
        "command": "python run.py --reset"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run in developer mode (hot reload)",
      "type": "shell",
      "command": "python3 run.py --dev",
      "windows": {
        "command": "python run.py --dev"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://localhost:8000"
    }
  ]
}
